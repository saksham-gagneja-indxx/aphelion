# ============================================
# SOCIAL MEDIA AUTOMATION - CONFIGURATION
# ============================================
# Key names here MUST match the aliases in backend/utils/config.py.
# Unknown keys are ignored silently, so a typo = a setting that never applies.

# ============ FLASK ============
FLASK_ENV=development
FLASK_PORT=5000
SECRET_KEY=your_secret_key_here_change_in_production
DEBUG=true

# ============ SECURITY ============
# Bearer token required on every /api/* call except the sign-in entry points.
# With it unset the API answers 503 to everything - it fails closed, not open.
API_ACCESS_KEY=your_api_access_key_here

# Origins allowed to call this API from a browser, comma-separated.
#
# Two values are refused outright rather than trusted:
#   *           - always. Combined with credentials it lets any site a
#                 signed-in user visits drive this API as them.
#   localhost   - when FLASK_ENV=production. Any process bound to that port
#                 on a user's machine could otherwise call the API as them.
#
# The refusal is logged and the origin dropped. If that empties the list, every
# cross-origin browser request is blocked - so a production deploy MUST set
# this to the real frontend URL. The development default below is not usable
# in production by design.
CORS_ORIGINS=http://localhost:5173

# ============ DATABASE ============
DATABASE_URL=sqlite:///data/automation.db
DB_ECHO=false

# ============ CLAUDE API (Phase 2 - not used in 24h scope) ============
# Still required by validate_settings(); placeholder is fine for now.
CLAUDE_API_KEY=sk-ant-placeholder-not-used-in-v1
CLAUDE_MODEL=claude-sonnet-5

# ============ INSTAGRAM ============
INSTAGRAM_USERNAME=your_instagram_username
INSTAGRAM_PASSWORD=your_instagram_password

# ============ TIMEZONE ============
TIMEZONE=Asia/Kolkata

# ============ FILE UPLOAD ============
UPLOAD_FOLDER=data/uploads
REELS_FOLDER=data/reels
MAX_UPLOAD_SIZE=524288000
ALLOWED_VIDEO_EXTENSIONS=["mp4","mov","avi","mkv","webm"]

# ============ SCHEDULER ============
SCHEDULER_ENABLED=true
SCHEDULER_CHECK_INTERVAL=60
SCHEDULER_MAX_WORKERS=4

# ============ LOGGING ============
LOG_LEVEL=INFO
LOG_FILE=data/logs/app.log

# ============ DEFERRED (Phase 2/3) ============
# LINKEDIN_EMAIL=
# LINKEDIN_PASSWORD=

# ============ MEDIA TOOLING ============
# Only needed if ffmpeg/ffprobe are not on PATH.
# FFMPEG_PATH=C:\path\to\ffmpeg.exe
# FFPROBE_PATH=C:\path\to\ffprobe.exe
