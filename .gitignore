# ============ ENVIRONMENT ============
.env
.env.local
.env.*.local
# Backups written by `python -m backend.admin_cli` before it edits .env. These
# are full copies of the file, secrets and all — ignoring only .env would leave
# them committable.
.env.bak
.env.*.bak
.env.backup*
.venv
venv/
ENV/
env/

